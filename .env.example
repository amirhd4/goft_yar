# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=goftyar
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/goftyar

# Security
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# PubSub & Event Streaming (redis / kafka / memory)
PUBSUB_ADAPTER=redis
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Gateway & Microservices
AUTH_SERVICE_URL=http://auth-service:8001
WIDGET_SERVICE_URL=http://widget-service:8002
CHAT_SERVICE_URL=http://chat-service:8003

# Frontend Client
VITE_API_BASE_URL=http://localhost:8000
